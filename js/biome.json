{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "files": { "includes": ["src/**", "test/**", "vitest.config.ts", "docs/**", "examples/src/**", "examples/scripts/**", "examples/vite.config.ts", "!src/generated/**"] },
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 4, "lineWidth": 130 },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
            "suspicious": { "noExplicitAny": "off" }
        }
    },
    "javascript": { "formatter": { "quoteStyle": "single" } }
}
