{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native/${presetName}",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TUMBLE_DEBUG": "ON" }
        },
        {
            "name": "release",
            "inherits": "debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "TUMBLE_DEBUG": "OFF" }
        },
        {
            "name": "asan",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
            }
        },
        {
            "name": "ubsan",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
            }
        },
        {
            "name": "labs",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/labs/native",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "TUMBLE_BUILD_LABS": "ON",
                "TUMBLE_BUILD_TESTS": "OFF",
                "TUMBLE_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "labs-web",
            "inherits": "labs",
            "binaryDir": "${sourceDir}/build/labs/web",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "ubsan", "configurePreset": "ubsan" },
        { "name": "labs", "configurePreset": "labs" },
        { "name": "labs-web", "configurePreset": "labs-web" }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "ubsan", "configurePreset": "ubsan", "output": { "outputOnFailure": true } }
    ]
}
