file(REMOVE_RECURSE "${PREFIX}" "${BUILD}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${TUMBLE_BUILD_DIR}" --prefix "${PREFIX}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "install failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CONSUMER}" -B "${BUILD}" -G Ninja -DCMAKE_PREFIX_PATH=${PREFIX}
                RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "configure failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "build failed")
endif()
execute_process(COMMAND "${BUILD}/game" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "the game failed")
endif()
