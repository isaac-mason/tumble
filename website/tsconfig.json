{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022", "DOM"],
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["@webgpu/types", "vite/client"],
        "paths": {
            "gpucat": ["./node_modules/gpucat"],
            "math": ["./node_modules/math"],
            "tumble.js": ["./node_modules/tumble.js"],
            "tumble.js/*": ["./node_modules/tumble.js/*"]
        }
    },
    "include": ["src"]
}
